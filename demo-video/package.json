{
  "name": "inventory-demo-video",
  "version": "1.0.0",
  "description": "高并发库存管理系统演示视频（Playwright 真实录屏 + Remotion + edge-tts）",
  "scripts": {
    "data": "node scripts/build-data.mjs",
    "tts": "python3 scripts/tts.py",
    "record": "node scripts/record.mjs",
    "render": "remotion render src/index.ts Demo build/remotion-render.mp4 --codec=h264 --crf=18 --audio-codec=aac --audio-bitrate=192k --concurrency=4",
    "mux": "ffmpeg -y -v error -i build/remotion-render.mp4 -c:v copy -af loudnorm=I=-16:TP=-1.5:LRA=11 -c:a aac -b:a 192k -ar 48000 -movflags +faststart out/demo.mp4",
    "all": "npm run data && npm run tts && npm run record && npm run render && npm run mux",
    "shots": "node scripts/shots.mjs ../docs/screenshots/redesign/after",
    "ui-check": "node scripts/interact.mjs /tmp/ui-check",
    "studio": "remotion studio src/index.ts"
  },
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@remotion/bundler": "^4.0.543",
    "@remotion/cli": "^4.0.543",
    "@remotion/renderer": "^4.0.543",
    "lucide-static": "^1.73.0",
    "playwright": "^1.65.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remotion": "^4.0.543",
    "typescript": "^7.0.2"
  },
  "private": true
}